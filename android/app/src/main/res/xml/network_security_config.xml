<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal cleartext allowance for same-device library import: the fork
     talks plain HTTP to the original app's share server on loopback. Only
     127.0.0.1/localhost may use cleartext; everything else keeps the
     platform default (cleartext blocked since targetSdk 28). Dart's own
     HttpClient bypasses this platform policy, so this is a safety net for
     any Java/native-stack path, not what makes the transfer work. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
